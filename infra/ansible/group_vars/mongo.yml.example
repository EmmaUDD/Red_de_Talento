# Copia este archivo a mongo.yml y reemplaza las contraseñas.
# Generar una contraseña random: openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | head -c 24

mongo_replica_set: rs0

mongo_admin_user: admin
mongo_admin_password: "CAMBIA_ESTA_PASSWORD"

mongo_app_db: red_talento_feed
mongo_app_user: app_user
mongo_app_password: "CAMBIA_ESTA_PASSWORD"
