# {{ ansible_managed }}
storage:
  dbPath: /var/lib/mongodb

systemLog:
  destination: file
  logAppend: true
  path: /var/log/mongodb/mongod.log

net:
  port: 27017
  bindIp: 0.0.0.0

replication:
  replSetName: "{{ mongo_replica_set }}"

{% if mongo_auth_enabled | default(false) %}
security:
  authorization: enabled
  keyFile: /etc/mongodb-keyfile
{% endif %}
